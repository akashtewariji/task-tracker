{
  "manifest_version": 3,
  "name": "To-Do List Extension",
  "description": "A simple to-do list app that persists even after restarting the browser.",
  "version": "1.0",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
